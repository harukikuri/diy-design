# ── Gemini へのつなぎ方は 2 通り。どちらも無ければルールベースにフォールバックする。

# (推奨) Vertex AI — 鍵を持たず、実行環境の資格情報で認証する。
#   ローカル: gcloud auth application-default login
#   Cloud Run: サービスアカウントに roles/aiplatform.user を付与
# 新しいモデルはリージョン限定のことがあるため、既定は global エンドポイント。
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# (簡易) AI Studio の API キー。無料枠は 20 リクエスト/分/モデルで、
# 1 回の設計に 4〜8 リクエスト使うためデモ用途には足りない。
# 取得: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 両方ある場合の明示指定 (vertex | api-key)。省略時は Vertex を優先。
AI_BACKEND=

# ── モデル
AGENT_MODEL=gemini-3.5-flash
FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash
IMAGE_MODEL=gemini-3.1-flash-image

# ── エージェントの制御
AGENT_RETRIES=1
MAX_TOOL_CALLS=16

# ローカルで動かすときのポート (Cloud Run では自動注入される)
PORT=8080
