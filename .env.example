# Gemini API キー。未設定でもアプリは動くが、設計はルールベースに落ち、
# 完成イメージの生成は無効になる。
# 取得: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 使うモデル (省略時は下記が既定)
AGENT_MODEL=gemini-3.8-flash
IMAGE_MODEL=gemini-3.1-flash-image

# エージェントの 1 リクエストあたりのツール呼び出し上限
MAX_TOOL_CALLS=16

# ローカルで動かすときのポート (Cloud Run では自動注入される)
PORT=8080
